# Copy to .env and fill in only what you need — every variable below is
# optional. BuildPilot runs with zero of these set (SQLite + local queue +
# local auth + the $0 deterministic AI analyzer + demo mode).

# Database. Defaults to file:./prisma/dev.db if unset.
DATABASE_URL="file:./prisma/dev.db"

# Session signing key. Required in production; falls back to a fixed
# dev-only value otherwise. Generate with: openssl rand -hex 32
# AUTH_SECRET=""

# Switch from local demo auth to Clerk — see docs/AUTH.md (not implemented,
# throws a clear error until you wire it up).
# AUTH_PROVIDER="clerk"

# Switch from the $0 deterministic AI analyzer to a real LLM via OpenRouter.
# Incurs real API cost. See docs/AI_SAFETY.md.
# AI_PROVIDER="openrouter"
# OPENROUTER_API_KEY=""
# OPENROUTER_MODEL="anthropic/claude-3.5-sonnet"

# Webhook secrets — required to accept real webhook deliveries from each
# provider. See docs/GITHUB_APP.md.
# WEBHOOK_SECRET_GITHUB=""
# WEBHOOK_SECRET_GITLAB=""
# WEBHOOK_SECRET_CIRCLECI=""

# Provider API tokens — required for real log fetching after a job fails.
# GITHUB_APP_TOKEN=""
# GITLAB_ACCESS_TOKEN=""
# CIRCLECI_API_TOKEN=""

# REST API / SDK / MCP server auth. Format: token:organizationId,token2:org2
# API_TOKENS=""

# Background queue backend. Only "bullmq" is a documented (unimplemented)
# alternative to the default local SQLite-backed queue — see
# src/lib/providers/queue/registry.ts.
# QUEUE_PROVIDER="bullmq"
